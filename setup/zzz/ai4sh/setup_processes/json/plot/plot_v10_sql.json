              "hint": "The root fp of the project"
            },
            {
              "parameter": "colormap",
              "parameter_type": "text",
              "required": false,
              "default_value": "default",
              "hint": "Colour ramp for plotting spectra: a matplotlib colormap name, or default = the spectra_plot parameter set (ml_setting, \"jet\")."
            },
            {
              "parameter": "max_spectra",
              "parameter_type": "integer",
              "required": false,
              "default_value": 0,
              "hint": "The maximum number of spectra to include in the plot"
            },
            {
              "parameter": "show",
              "parameter_type": "boolean",
              "required": false,
              "default_value": true,
              "hint": "True or false if you want to show the plot on screen"
            },
            {
              "parameter": "save",
              "parameter_type": "boolean",
              "required": false,
              "default_value": false,
              "hint": "True or false if you want to save the plot to file"
            }
          ]
        }
      ]
    },
    {
      "process": "add_process",
      "overwrite": false,
      "parameters": {
        "root_process": "plot",
        "process": "plot_spectra_variable_scaling",
        "min_user_stratum": 1,
        "title": "Plot variable scaling methods",
        "label": "Plot a comparison of the variable (band-wise) scaling methods: meancentring, autoscaling, paretoscaling and poissonscaling."
      },
      "nodes": [
        {
          "parent": "process",
          "element": "parameters",
          "parameter": [
            {
              "parameter": "project_root_fp",
              "parameter_type": "text",
              "required": false,
              "default_value": "",
              "hint": "The root fp of the project"
            },
            {
