              "parameter_type": "text",
              "required": false,
              "default_value": "default",
              "hint": "Colour ramp for plotting spectra: a matplotlib colormap name, or default = the spectra_plot parameter set (ml_setting, \"jet\")."
            },
            {
              "parameter": "max_spectra",
              "parameter_type": "integer",
