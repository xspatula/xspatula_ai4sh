{
  "process": [
    {
      "process_id": "create_table",
      "overwrite": false,
      "delete": false,
      "parameters": {
        "schema": "organism_utility",
        "table": "taxon",
        "command": [
          "id SERIAL",
          "parent_taxon_id INTEGER REFERENCES organism_utility.taxon (id)",
          "taxon_rank_id SMALLINT REFERENCES organism_utility.taxon_rank (id)",
          "taxon_status_id INTEGER REFERENCES organism_utility.taxon_status (id)",
          "taxonomy_reference_id INTEGER REFERENCES organism_utility.taxonomy_reference (id)",
          "name TEXT",
          "scientific_name TEXT",
          "UNIQUE NULLS NOT DISTINCT (parent_taxon_id, name)",
          "PRIMARY KEY (id)"
        ],
        "index": [
          [
            "name"
          ],
          [
            "scientific_name"
          ]
        ],
        "comment": {
          "columns": {
            "name": "Taxon name at its rank; for species the epithet only (e.g. elkanii)",
            "scientific_name": "Full scientific name, e.g. bradyrhizobium elkanii for a species; equals name above species rank"
          }
        }
      },
      "audit": {
        "INSERT": false,
        "UPDATE": true,
        "DELETE": true
      }
    }
  ]
}
