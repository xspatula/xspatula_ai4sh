                "schema": "observation",
                "table": "app_aggregate_stability",
                "write": true
              },
              "permission": {
                "update": true,
                "delete": false
              }
            },
            {
              "parameter": "subsample",
              "parameter_type": "text",
              "required": false,
              "default_value": "a",
              "hint": "Subsample name (only accpets values in a, b, c, ... h), applicable if the same sample is divided and observed more than once in the same log",
              "schema_table": {
                "schema": "observation",
                "table": "observation",
                "write": true
              },
              "permission": {
                "update": false,
                "delete": false
              },
              "set_value": [
                {
                  "value": "a",
                  "label": "A"
                },
                {
                  "value": "b",
                  "label": "B"
                },
                {
                  "value": "c",
                  "label": "C"
                },
                {
                  "value": "d",
                  "label": "D"
                },
                {
                  "value": "e",
                  "label": "E"
                },
                {
                  "value": "f",
                  "label": "F"
                },
                {
                  "value": "g",
                  "label": "G"
                },
                {
                  "value": "h",
                  "label": "H"
                }
              ]
            },
            {
              "parameter": "abstract",
              "parameter_type": "text",
              "required": false,
              "default_value": "",
              "hint": "Any notation related to the observation",
              "schema_table": {
                "schema": "observation",
                "table": "observation",
                "write": true
              },
              "permission": {
                "update": true,
                "delete": true
              }
            },
            {
              "parameter": "observed_at",
              "parameter_type": "timestamp",
              "required": false,
              "default_value": 0,
              "hint": "The date of the observation, leave blank to set today as date",
              "schema_table": {
                "schema": "observation",
                "table": "observation",
                "write": true
              },
              "permission": {
                "update": false,
                "delete": false
              }
            }
          ]
        }
