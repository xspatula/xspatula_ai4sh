{
  "process": [
    {
      "process": "add_process",
      "overwrite": false,
      "parameters": {
        "root_process": "manage_table_data",
        "process": "manage_app_aggregate_stability_observation",
        "min_user_stratum": 2,
        "title": "Manage app aggregate stability observation",
        "label": "Insert, update or delete app aggregate stability observation data."
      },
      "nodes": [
        {
          "parent": "process",
          "element": "parameters",
          "parameter": [
            {
              "parameter": "sampling_log_id__sampling_log_name",
              "parameter_type": "text",
              "required": true,
              "default_value": "",
              "hint": "The name of the sampling log to which this observation belongs",
              "schema_table": {
                "schema": "observation",
                "table": "sampling_log",
                "write": true
              },
              "permission": {
                "update": false,
                "delete": false
              }
            },
            {
              "parameter": "sample_id__sample_name",
              "parameter_type": "text",
              "required": true,
              "default_value": "",
              "hint": "The name of the sample",
              "schema_table": {
                "schema": "observation",
                "table": "observation",
                "write": true
              },
              "permission": {
                "update": false,
                "delete": false
              }
            },
            {
              "parameter": "provision_id__provision_name",
              "parameter_type": "text",
              "required": false,
              "default_value": "slakes",
              "hint": "Name of application (e.g. slakes or moulder)",
              "schema_table": {
                "schema": "observation",
                "table": "observation",
                "write": true
              },
              "permission": {
                "update": false,
                "delete": false
              }
            },
            {
              "parameter": "observation_log_id__observation_log_name",
              "parameter_type": "text",
              "required": false,
              "default_value": "auto",
              "hint": "Let the observation_log_name be set automatically",
              "schema_table": {
                "schema": "observation",
                "table": "observation",
                "write": true
              },
              "permission": {
                "update": false,
                "delete": false
              },
              "auto_name": {
                "concat": "'%s@slakes' %(sampling_log_id__sampling_log_tag)"
              }
            },
            {
              "parameter": "stability_index",
              "parameter_type": "float",
              "required": true,
              "default_value": 0,
              "hint": "The stability index reported by the app.",
