{
  "process": [
    {
      "process": "add_root_process",
      "overwrite": false,
      "parameters": {
        "root_process": "plot",
        "title": "Plot data",
        "label": "Root for plotting data"
      }
    },
    {
      "process": "add_process",
      "overwrite": false,
      "parameters": {
        "root_process": "plot",
        "process": "plot_indicators",
        "min_user_stratum": 1,
        "title": "Plot indicators",
        "label": "Plot indicators."
      },
      "nodes": [
        {
          "parent": "process",
          "element": "parameters",
          "parameter": [
            {
              "parameter": "project_root_fp",
              "parameter_type": "text",
              "required": false,
              "default_value": "",
              "hint": "The root fp of the project"
            },
            {
              "parameter": "indicator_array",
              "parameter_type": "array",
              "required": false,
              "default_value": "",
              "hint": "Comma separated list of the indicators to plot"
            },
            {
              "parameter": "covariate_array",
              "parameter_type": "array",
              "required": false,
              "default_value": "",
              "hint": "Comma separated list of the covariates to plot; nominal (class) covariates are plotted as class counts"
            },
            {
              "parameter": "max_classes",
              "parameter_type": "integer",
              "required": false,
              "default_value": 15,
              "hint": "Max number of classes shown per nominal covariate; the remaining classes are summed as other"
            },
            {
              "parameter": "class_label",
              "parameter_type": "text",
              "required": false,
              "default_value": "display_name",
              "hint": "Label of class covariates (land cover, land use, biogeo16) in plots: display_name, tag, name or alias"
            },
            {
              "parameter": "targetfeaturesymbols",
              "parameter_type": "text",
              "required": false,
              "default_value": "default",
              "hint": "The name of JSON file defining the symbolisation of the indicators"
            },
            {
              "parameter": "standardisation",
              "parameter_type": "text",
              "required": false,
              "default_value": "default",
              "hint": "Indicator standardisation applied before plotting, default applies a predefined standardisation set for each indicator, none skips all standardisation."
            },
            {
              "parameter": "transformation",
              "parameter_type": "text",
              "required": false,
              "default_value": "default",
              "hint": "Indicator transformation applied before plotting, default applies a predefined transformation set for each indicator, none skips all transformations."
            },
            {
              "parameter": "boxplot",
              "parameter_type": "boolean",
              "required": false,
              "default_value": true,
              "hint": "True for plotting boxplot diagrams, false not to"
            },
            {
              "parameter": "histogram",
              "parameter_type": "boolean",
              "required": false,
              "default_value": true,
              "hint": "True or false if you want a histogram plot"
            },
            {
              "parameter": "single_canvas_plot",
              "parameter_type": "boolean",
              "required": false,
              "default_value": false,
              "hint": "True or false if you want all plots on a single canvas"
            },
            {
              "parameter": "individual_canvas_plot",
              "parameter_type": "boolean",
              "required": false,
              "default_value": true,
              "hint": "True or false if you want each plot on an individual canvas"
            },
            {
              "parameter": "show",
              "parameter_type": "boolean",
              "required": false,
              "default_value": true,
              "hint": "True or false if you want to show the plot on screen"
            },
            {
              "parameter": "save",
              "parameter_type": "boolean",
              "required": false,
              "default_value": false,
              "hint": "True or false if you want to save the plot to file"
            }
          ]
        }
      ]
    },
    {
      "process": "add_process",
      "overwrite": true,
      "parameters": {
        "root_process": "plot",
        "process": "plot_spectra",
        "min_user_stratum": 1,
        "title": "Plot indicators",
        "label": "Plot indicators."
      },
      "nodes": [
        {
          "parent": "process",
          "element": "parameters",
          "parameter": [
            {
              "parameter": "project_root_fp",
              "parameter_type": "text",
              "required": false,
              "default_value": "",
              "hint": "The root fp of the project"
            },
            {
              "parameter": "multi_filter",
              "parameter_type": "text",
              "required": false,
              "default_value": "none",
              "hint": "A multi_filter can apply different filters and filter definitions for different ranges in the spectra and requires a customized definition in a JSON file, to run a multi_filter set filter to none and give the relative or absolute path to the JSON file with the multi_filter definition."
            },
            {
              "parameter": "filter",
              "parameter_type": "text",
              "required": false,
              "default_value": "",
              "hint": "The filter to apply"
            },
            {
              "parameter": "chemometrics_array",
              "parameter_type": "array",
              "required": false,
              "default_value": "",
              "hint": "Steps applied in the listed order. Each item is a method name with default settings: moving-average, gauss, savitzky-golay, lowess (filters), l1, l2, max, snv, msc (scatter correction), derivative (1st), meancentring, autoscaling, paretoscaling, poissonscaling (variable scaling), pca (5 components); or an object with custom settings: {\"filter\": <set name, JSON path or settings>}, {\"multi_filter\": ...}, {\"scatter_correction\": [\"snv\",\"snv\"]}, {\"derivative\": 2}, {\"scaling\": \"autoscaling\"}, {\"variance_threshold\": {\"threshold\": 0.03, \"scaler\": \"minmax\"}}, {\"ward_clustering\": {\"n_clusters\": 40, \"connectivity\": true}} (n_clusters required), {\"pca\": 5}."
            },
            {
              "parameter": "colormap",
              "parameter_type": "text",
              "required": false,
              "default_value": "default",
              "hint": "Colour ramp for plotting spectra: a matplotlib colormap name, or default = the spectra_plot parameter set (ml_setting, \"jet\")."
            },
            {
              "parameter": "max_spectra",
              "parameter_type": "integer",
              "required": false,
              "default_value": 0,
              "hint": "The maximum number of spectra to include in the plot"
            },
            {
              "parameter": "show",
              "parameter_type": "boolean",
              "required": false,
              "default_value": true,
              "hint": "True or false if you want to show the plot on screen"
            },
            {
              "parameter": "save",
              "parameter_type": "boolean",
              "required": false,
              "default_value": false,
              "hint": "True or false if you want to save the plot to file"
            }
          ]
        }
      ]
    },
    {
      "process": "add_process",
      "overwrite": false,
      "parameters": {
        "root_process": "plot",
        "process": "plot_spectra_scatter_correction",
        "min_user_stratum": 1,
        "title": "Plot scatter corrections",
        "label": "Plot a comparison of the scatter corrections (per spectrum): l1, l2, max, snv and msc."
      },
      "nodes": [
        {
          "parent": "process",
          "element": "parameters",
          "parameter": [
