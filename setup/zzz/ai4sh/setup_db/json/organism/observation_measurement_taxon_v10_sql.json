{
  "process": [
    {
      "process_id": "create_table",
      "overwrite": false,
      "delete": false,
      "parameters": {
        "schema": "observation",
        "table": "taxon_observation_measurement",
        "command": [
          "id BIGSERIAL",
          "observation_id INTEGER REFERENCES observation.observation (id)",
          "indicator_id INTEGER REFERENCES observation_utility.indicator (id)",
          "taxon_id INTEGER REFERENCES organism_utility.taxon (id)",
          "value DOUBLE PRECISION",
          "UNIQUE (observation_id, indicator_id, taxon_id)",
          "PRIMARY KEY (id)"
        ]
      },
      "audit": {
        "INSERT": true,
        "UPDATE": true,
        "DELETE": true
      }
    }
  ]
}
